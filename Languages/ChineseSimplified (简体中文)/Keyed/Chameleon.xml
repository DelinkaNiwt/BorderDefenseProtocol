<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- 变色龙芯片名称。 -->
  <BDP_ChipFunction_Chameleon>变色龙</BDP_ChipFunction_Chameleon>
  <!-- 变色龙芯片说明。 -->
  <BDP_ChipFunction_Chameleon_Description>进入隐秘状态并隐藏自身；任意攻击动作完成后移除隐秘状态。攻击能力也会触发破隐，位移、治疗和增益能力不会触发。</BDP_ChipFunction_Chameleon_Description>
  <!-- 变色龙能力按钮名称。 -->
  <BDP_Ability_Chameleon.label>释放隐秘状态</BDP_Ability_Chameleon.label>
  <!-- 变色龙能力按钮说明。 -->
  <BDP_Ability_Chameleon.description>释放变色龙隐秘状态。</BDP_Ability_Chameleon.description>
  <!-- 变色龙表达能力条目名称。 -->
  <BDP_Expression_ChameleonToggle>释放隐秘状态</BDP_Expression_ChameleonToggle>
</LanguageData>
