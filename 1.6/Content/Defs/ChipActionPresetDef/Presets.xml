<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    BDP 芯片动作预设定义。
    每个 ChipActionPresetDef 承载一个可选动作的静态定义数据。
    类别和标签决定它在制造面板中如何被筛选和路由。
  -->

  <!-- ===== 远程射击预设（射手/枪手共用）===== -->

  <!-- 小行星：标准直射远程动作。 -->
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>
    <defName>BDP_Preset_Asteroid</defName>
    <label>小行星</label>
    <description>标准直射远程动作。子弹沿直线飞行，命中目标造成伤害。远程攻击的基础模板。</description>
    <profession>BDP_ChipProfession_Shooter</profession>
    <costList>
      <Silver>80</Silver>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <additionalWorkAmount>500</additionalWorkAmount>
    <config>
      <Profile>
        <Category>BDP_ChipCategory_Weapon</Category>
        <Tags>
        </Tags>
      </Profile>
      <Loadout>
        <SlotRegion>MainSub</SlotRegion>
        <SlotOccupancy>Single</SlotOccupancy>
        <ActivationDelayTicks>60</ActivationDelayTicks>
        <DeactivationDelayTicks>30</DeactivationDelayTicks>
      </Loadout>
      <Trion><CapacityCost>50</CapacityCost><ActivationCost>15</ActivationCost></Trion>
      <ActivationRequirements>
        <li Class="BDP.Core.Requirements.TrionIntensityRequirement"><Minimum>1</Minimum></li>
      </ActivationRequirements>
      <Expression>
        <Entries>
          <li>
            <Id>sequential_primary</Id>
            <DisplayLabel>小行星</DisplayLabel>
            <Kind>PrimaryVerb</Kind>
            <WeaponMode>Ranged</WeaponMode>
            <Trion><UseCost>4</UseCost></Trion>
            <Execution><Rhythm>Simultaneous</Rhythm></Execution>
            <VerbProps>
              <verbClass>BDP.Core.Verbs.BdpVerb_Shoot</verbClass>
              <hasStandardCommand>true</hasStandardCommand>
              <label>小行星</label>
              <defaultProjectile>BDP_Projectile_Normal</defaultProjectile>
              <range>30.9</range>
              <burstShotCount>4</burstShotCount>
              <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
              <warmupTime>1.8</warmupTime>
              <defaultCooldownTime>1.2</defaultCooldownTime>
              <accuracyTouch>0.85</accuracyTouch>
              <accuracyShort>0.75</accuracyShort>
              <accuracyMedium>0.50</accuracyMedium>
              <accuracyLong>0.20</accuracyLong>
              <soundCast>Shot_Revolver</soundCast>
              <!-- 目标判定与原版枪械一致：不可瞄地面，可瞄单位/建筑 -->
              <targetParams>
                <canTargetLocations>false</canTargetLocations>
                <canTargetBuildings>true</canTargetBuildings>
                <canTargetPawns>true</canTargetPawns>
              </targetParams>
            </VerbProps>
            <DirectTargetLineOfSight>Required</DirectTargetLineOfSight>
          </li>
        </Entries>
      </Expression>
    </config>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>

  <!-- 毒蛇：路线引导远程动作。 -->
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>
    <defName>BDP_Preset_Viper</defName>
    <label>毒蛇</label>
    <description>路线引导远程动作。玩家用 Shift+左键 设定弹道路径锚点，子弹按路径分段飞行。</description>
    <profession>BDP_ChipProfession_Shooter</profession>
    <costList>
      <Silver>120</Silver>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <additionalWorkAmount>800</additionalWorkAmount>
    <config>
      <Profile>
        <Category>BDP_ChipCategory_Weapon</Category>
        <Tags>
        </Tags>
      </Profile>
      <Loadout>
        <SlotRegion>MainSub</SlotRegion>
        <SlotOccupancy>Single</SlotOccupancy>
        <ActivationDelayTicks>60</ActivationDelayTicks>
        <DeactivationDelayTicks>30</DeactivationDelayTicks>
      </Loadout>
      <Trion><CapacityCost>80</CapacityCost><ActivationCost>15</ActivationCost></Trion>
      <ActivationRequirements>
        <li Class="BDP.Core.Requirements.TrionIntensityRequirement"><Minimum>1</Minimum></li>
      </ActivationRequirements>
      <Expression>
        <Entries>
          <li>
            <Id>viper_primary</Id>
            <DisplayLabel>毒蛇</DisplayLabel>
            <Kind>PrimaryVerb</Kind>
            <WeaponMode>Ranged</WeaponMode>
            <Trion><UseCost>8</UseCost></Trion>
            <Execution><Rhythm>Simultaneous</Rhythm></Execution>
            <VerbProps>
              <verbClass>BDP.Core.Verbs.BdpVerb_Shoot</verbClass>
              <hasStandardCommand>true</hasStandardCommand>
              <label>毒蛇</label>
              <defaultProjectile>BDP_Projectile_Variable</defaultProjectile>
              <range>30.9</range>
              <burstShotCount>4</burstShotCount>
              <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
              <warmupTime>1.2</warmupTime>
              <defaultCooldownTime>1.2</defaultCooldownTime>
              <accuracyTouch>0.85</accuracyTouch>
              <accuracyShort>0.75</accuracyShort>
              <accuracyMedium>0.50</accuracyMedium>
              <accuracyLong>0.22</accuracyLong>
              <soundCast>BDP_Sound_ViperCast</soundCast>
              <!-- 路线引导需要可瞄地面 -->
              <targetParams>
                <canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>true</canTargetBuildings>
                <canTargetPawns>true</canTargetPawns>
              </targetParams>
            </VerbProps>
            <DirectTargetLineOfSight>NotRequired</DirectTargetLineOfSight>
            <RangedModules>
              <li><moduleDef>BDP_RoutePathModule</moduleDef></li>
            </RangedModules>
          </li>
        </Entries>
      </Expression>
    </config>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>

  <!-- 猎犬：远程追踪动作。 -->
