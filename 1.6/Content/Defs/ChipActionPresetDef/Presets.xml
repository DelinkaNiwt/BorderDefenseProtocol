    <defName>BDP_Preset_Toki</defName>
    <label>朱鹮</label>
    <description>超远距精确狙击芯片。发射标准狙击弹，越远越准，单发高伤害，但预热极慢。</description>
    <profession>BDP_ChipProfession_Sniper</profession>
    <costList>
      <Silver>80</Silver>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <additionalWorkAmount>500</additionalWorkAmount>
    <config>
      <Profile>
        <Category>BDP_ChipCategory_Weapon</Category>
        <Tags>
        </Tags>
      </Profile>
      <Loadout>
        <SlotRegion>MainSub</SlotRegion>
        <SlotOccupancy>Single</SlotOccupancy>
        <ActivationDelayTicks>60</ActivationDelayTicks>
        <DeactivationDelayTicks>30</DeactivationDelayTicks>
      </Loadout>
      <Trion><CapacityCost>80</CapacityCost><ActivationCost>30</ActivationCost></Trion>
      <ActivationRequirements>
        <li Class="BDP.Core.Requirements.TrionIntensityRequirement"><Minimum>1</Minimum></li>
      </ActivationRequirements>
      <Expression>
        <Entries>
          <li>
            <Id>toki_primary</Id>
            <DisplayLabel>朱鹮</DisplayLabel>
            <Kind>PrimaryVerb</Kind>
            <WeaponMode>Ranged</WeaponMode>
            <Trion><UseCost>15</UseCost></Trion>
            <Execution><Rhythm>Sequential</Rhythm></Execution>
            <VerbProps>
              <verbClass>BDP.Core.Verbs.BdpVerb_Shoot</verbClass>
              <hasStandardCommand>true</hasStandardCommand>
              <label>朱鹮</label>
              <defaultProjectile>BDP_Projectile_SniperStandard</defaultProjectile>
              <range>69.9</range>
              <burstShotCount>1</burstShotCount>
              <warmupTime>3.5</warmupTime>
              <defaultCooldownTime>1.5</defaultCooldownTime>
              <accuracyTouch>0.50</accuracyTouch>
              <accuracyShort>0.70</accuracyShort>
              <accuracyMedium>0.88</accuracyMedium>
              <accuracyLong>0.90</accuracyLong>
              <soundCast>Shot_SniperRifle</soundCast>
              <soundCastTail>GunTail_Heavy</soundCastTail>
              <noiseRadius>25</noiseRadius>
              <muzzleFlashScale>1.1</muzzleFlashScale>
              <!-- 目标判定与原版枪械一致：不可瞄地面，可瞄单位/建筑 -->
              <targetParams>
                <canTargetLocations>false</canTargetLocations>
                <canTargetBuildings>true</canTargetBuildings>
                <canTargetPawns>true</canTargetPawns>
              </targetParams>
            </VerbProps>
            <Presentation>
              <VisualPresetDefName>BDP_Visual_SniperRifle</VisualPresetDefName>
            </Presentation>
            <DirectTargetLineOfSight>Required</DirectTargetLineOfSight>
          </li>
        </Entries>
      </Expression>
    </config>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>

  <!-- ===== 蚱蜢：机动弹射能力 ===== -->

  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>
    <defName>BDP_Preset_Grasshopper</defName>
    <label>蚱蜢</label>
    <description>机动型芯片。在脚下凝聚Trion弹射跳板，以爆发性速度弹向目标位置。冷却5秒，每次使用消耗30 Trion。</description>
    <costList>
      <Silver>80</Silver>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <additionalWorkAmount>500</additionalWorkAmount>
    <config>
      <Profile>
        <!-- 能力类芯片 -->
        <Category>BDP_ChipCategory_Ability</Category>
        <Tags>
        </Tags>
      </Profile>
      <Loadout>
        <SlotRegion>MainSub</SlotRegion>                      <!-- 可装主槽或副槽 -->
        <SlotOccupancy>Single</SlotOccupancy>
        <ActivationDelayTicks>30</ActivationDelayTicks>       <!-- 0.5秒预热 -->
        <DeactivationDelayTicks>15</DeactivationDelayTicks>   <!-- 0.25秒关闭延迟 -->
      </Loadout>
      <Trion>
        <CapacityCost>100</CapacityCost>                      <!-- 常驻占用 100 Trion -->
        <ActivationCost>15</ActivationCost>                   <!-- 激活时一次性消耗 15 Trion -->
      </Trion>
      <ActivationRequirements>
        <li Class="BDP.Core.Requirements.TrionIntensityRequirement"><Minimum>1</Minimum></li>
      </ActivationRequirements>
      <Expression>
        <Entries>
          <li>
            <Id>grasshopper_ability</Id>
            <DisplayLabel>蚱蜢</DisplayLabel>
            <Kind>Ability</Kind>                              <!-- 能力类表达条目 -->
            <AbilityDefName>BDP_Ability_Grasshopper</AbilityDefName>
            <Trion>
              <UseCost>20</UseCost>                           <!-- 每次跳跃消耗 20 Trion -->
            </Trion>
          </li>
        </Entries>
      </Expression>
    </config>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>

</Defs>
