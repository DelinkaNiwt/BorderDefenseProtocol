  <!-- 铅弹：开放式被动远程增强，不绑定猎犬、枪壳或任何具体目标芯片。 -->
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>
    <!-- 被动芯片唯一名称。 -->
    <defName>BDP_Preset_LeadShot</defName>
    <!-- 玩家可见芯片名称。 -->
    <label>铅弹</label>
    <labelKey>BDP_ChipAction_LeadShot</labelKey>
    <!-- 玩家可见芯片说明。 -->
    <description>被动远程增强。激活后，所有有效远程武装的攻击入口前增加铅弹，并使命中目标承受铅块负重；本次投射物不造成伤害并尝试绕过已知护盾。</description>
    <descriptionKey>BDP_ChipAction_LeadShot_Description</descriptionKey>
    <!-- 铅弹属于被动芯片分类。 -->
    <config>
      <!-- 分类与标签。 -->
      <Profile>
        <Category>BDP_ChipCategory_Passive</Category>
        <Tags>
          <li>BDP_ChipTag_Offensive</li>
        </Tags>
      </Profile>
      <!-- 铅弹使用主槽或副槽，不生成独立攻击按钮。 -->
      <Loadout>
        <SlotRegion>MainSub</SlotRegion>
        <SlotOccupancy>Single</SlotOccupancy>
        <ActivationDelayTicks>0</ActivationDelayTicks>
        <DeactivationDelayTicks>0</DeactivationDelayTicks>
      </Loadout>
      <!-- 被动芯片容量与激活参数。 -->
      <Trion><CapacityCost>100</CapacityCost><ActivationCost>0</ActivationCost></Trion>
      <!-- 激活最低 Trion 强度要求。 -->
      <ActivationRequirements>
        <li Class="BDP.Core.Requirements.TrionIntensityRequirement"><Minimum>1</Minimum></li>
      </ActivationRequirements>
      <!-- 表达条目只发布开放式远程增强声明。 -->
      <Expression>
        <Entries>
          <li>
            <!-- 被动表达条目标识。 -->
            <Id>lead_shot_passive</Id>
            <!-- 该名称也作为动态远程入口名称前缀来源。 -->
            <DisplayLabel>铅弹</DisplayLabel>
            <DisplayLabelKey>BDP_Expression_LeadShot</DisplayLabelKey>
            <Kind>Passive</Kind>
            <PassiveKey>BDP_LeadShot</PassiveKey>
            <!-- 按远程武装能力匹配，不指定目标芯片。 -->
            <RangedModuleAugmentations>
              <li>
                <!-- 所有有效远程武装结果均可接收。 -->
                <AppliesToCapability>RangedWeapon</AppliesToCapability>
                <!-- 名称前缀使用本表达条目的玩家可见名称。 -->
                <DisplayNamePrefixMode>SourceExpressionLabel</DisplayNamePrefixMode>
                <!-- 追加铅块负重命中模块。 -->
                <Modules>
                  <li>
                    <moduleDef>BDP_RangedDebuff_LeadWeight</moduleDef>
                  </li>
                </Modules>
              </li>
            </RangedModuleAugmentations>
          </li>
        </Entries>
      </Expression>
    </config>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>

