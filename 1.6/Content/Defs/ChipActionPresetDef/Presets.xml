  <!-- ===== 变色龙：可在攻击后自动关闭的隐身状态 ===== -->

  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>
    <defName>BDP_Preset_Chameleon</defName>
    <!-- 缺少语言键时使用的默认名称。 -->
    <label>变色龙</label>
    <!-- 正式名称走语言包。 -->
    <labelKey>BDP_ChipAction_Chameleon</labelKey>
    <!-- 缺少语言键时使用的默认说明。 -->
    <description>进入隐秘状态并隐藏自身；任意攻击动作完成后立即关闭。</description>
    <!-- 正式说明走语言包。 -->
    <descriptionKey>BDP_ChipAction_Chameleon_Description</descriptionKey>
    <!-- 状态芯片不绑定攻击职业。 -->
    <costList>
      <Silver>100</Silver>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <!-- 与同档状态芯片保持一致的制造工作量。 -->
    <additionalWorkAmount>600</additionalWorkAmount>
    <config>
      <!-- 变色龙只声明状态主分类。 -->
      <Profile>
        <Category>BDP_ChipCategory_Status</Category>
        <Tags>
        </Tags>
      </Profile>
      <!-- 互斥组芯片必须走可切换的主副槽。 -->
      <Loadout>
        <SlotRegion>MainSub</SlotRegion>
        <SlotOccupancy>Single</SlotOccupancy>
        <ActivationExclusionGroups>
          <li>BDP_ChipExclusionGroup_Stealth</li>
        </ActivationExclusionGroups>
        <!-- 使用原版 Core 音效，不引用皇权灵能或其它 DLC。 -->
        <ActivationAudio>
          <!-- 激活前摇开始提示。 -->
          <ActivationWarmupStartSound>Power_OnSmall</ActivationWarmupStartSound>
          <!-- 激活前摇期间的持续提示。 -->
          <ActivationWarmupLoopSound>GasReleasing</ActivationWarmupLoopSound>
          <!-- 芯片正式激活完成提示。 -->
          <ActivationWarmupEndSound>Power_OffSmall</ActivationWarmupEndSound>
        </ActivationAudio>
        <ActivationDelayTicks>30</ActivationDelayTicks>
        <DeactivationDelayTicks>0</DeactivationDelayTicks>
      </Loadout>
      <!-- 容量占用由战斗体生成/解除生命周期处理；激活费只在芯片正式激活时结算。 -->
      <Trion>
        <CapacityCost>100</CapacityCost>
        <ActivationCost>15</ActivationCost>
      </Trion>
      <!-- 变色龙的最低 Trion 释放力门槛。 -->
      <ActivationRequirements>
        <li Class="BDP.Core.Requirements.TrionIntensityRequirement">
          <Minimum>1</Minimum>
        </li>
      </ActivationRequirements>
      <Expression>
        <Entries>
          <!-- 隐身状态由正式 Hediff 表达宿主承载。 -->
          <li>
            <Id>chameleon_stealth_state</Id>
            <DisplayLabel>隐秘状态·变色龙</DisplayLabel>
            <Kind>Hediff</Kind>
            <HediffDefName>BDP_Hediff_Chameleon</HediffDefName>
            <Trion>
              <!-- 单枚有效来源时整组隐身效果每秒消耗 5 Trion。 -->
              <SustainCostBySourceCount>
                <li>
                  <SourceCount>1</SourceCount>
                  <TotalPerSecond>5</TotalPerSecond>
                </li>
              </SustainCostBySourceCount>
            </Trion>
          </li>
        </Entries>
      </Expression>
    </config>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>

</Defs>
