            </RangedModules>
          </li>
        </Entries>
      </Expression>
    </config>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>

  <!-- ===== 实体系/能力系/防护系预设 ===== -->

  <!-- 弧月：近战实体武装。 -->
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>
    <defName>BDP_Preset_Kogetsu</defName>
    <label>弧月</label>
    <profession>BDP_ChipProfession_Attacker</profession>
    <description>以实体弧月刃形成近战武装，并作为旋空弧月组合的主侧芯片。</description>
    <costList>
      <Silver>150</Silver>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <additionalWorkAmount>900</additionalWorkAmount>
    <config>
      <Profile>
        <Category>BDP_ChipCategory_Weapon</Category>
        <Tags>
          <li>BDP_ChipTag_Entity</li>
        </Tags>
      </Profile>
      <Loadout>
        <SlotRegion>MainSub</SlotRegion>
        <SlotOccupancy>Single</SlotOccupancy>
        <ActivationDelayTicks>30</ActivationDelayTicks>
        <DeactivationDelayTicks>15</DeactivationDelayTicks>
      </Loadout>
      <Trion><CapacityCost>50</CapacityCost><ActivationCost>15</ActivationCost></Trion>
      <ActivationRequirements>
        <li Class="BDP.Core.Requirements.TrionIntensityRequirement"><Minimum>1</Minimum></li>
      </ActivationRequirements>
      <Expression>
        <Entries>
          <li>
            <Id>kogetsu_primary</Id>
            <DisplayLabel>弧月</DisplayLabel>
            <Kind>PrimaryVerb</Kind>
            <WeaponMode>Melee</WeaponMode>
            <!-- 近战不适用 Trion 消耗 -->
            <Presentation>
              <VisualPresetDefName>BDP_Visual_Kogetsu</VisualPresetDefName>
            </Presentation>
            <tools>
              <li>
                <label>弧月刃</label>
                <capacities><li>Cut</li></capacities>
                <power>20</power>
                <cooldownTime>2.0</cooldownTime>
                <armorPenetration>0.15</armorPenetration>
              </li>
            </tools>
          </li>
        </Entries>
      </Expression>
    </config>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>

  <!-- 旋空：能量体系能力，弧月专属副侧。 -->
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>
    <defName>BDP_Preset_Senku</defName>
    <label>旋空</label>
    <description>以能量体形式参与旋空弧月组合，为组合结果提供进攻型副侧来源。</description>
    <costList>
      <Silver>100</Silver>
    </costList>
    <additionalWorkAmount>600</additionalWorkAmount>
    <config>
      <Profile>
        <Category>BDP_ChipCategory_Ability</Category>
        <Tags>
          <li>BDP_ChipTag_Offensive</li>
          <li>BDP_ChipTag_KogetsuExclusive</li>
          <li>BDP_ChipTag_EnergyForm</li>
        </Tags>
      </Profile>
      <Loadout>
        <SlotRegion>MainSub</SlotRegion>
        <SlotOccupancy>Single</SlotOccupancy>
        <ActivationDelayTicks>15</ActivationDelayTicks>
        <DeactivationDelayTicks>15</DeactivationDelayTicks>
      </Loadout>
      <Trion><CapacityCost>50</CapacityCost><ActivationCost>15</ActivationCost></Trion>
      <ActivationRequirements>
        <li Class="BDP.Core.Requirements.TrionIntensityRequirement"><Minimum>4</Minimum></li>
        <li Class="BDP.Core.Requirements.SkillLevelRequirement">
          <Skill>Melee</Skill>
          <MinimumLevel>10</MinimumLevel>
        </li>
        <li Class="BDP.Core.Requirements.SkillLevelRequirement">
          <Skill>Shooting</Skill>
          <MinimumLevel>6</MinimumLevel>
        </li>
      </ActivationRequirements>
      <Expression>
        <Entries>
          <li>
            <Id>senku_passive</Id>
            <DisplayLabel>旋空</DisplayLabel>
            <Kind>Passive</Kind>
            <PassiveKey>bdp.senku.passive</PassiveKey>
            <Trion><UseCost>100</UseCost><MinimumRequired>100</MinimumRequired></Trion>
          </li>
        </Entries>
      </Expression>
    </config>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>

  <!-- 护盾：能量防护。 -->
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>
    <defName>BDP_Preset_EnergyShield</defName>
    <label>护盾</label>
    <description>形成正面能量护盾。单枚激活时覆盖正面 180 度；主、副槽各激活一枚时升级为全防御能量护盾。成功抵挡会消耗相当于伤害值 50% 的 Trion。</description>
    <costList>
      <Silver>120</Silver>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <additionalWorkAmount>700</additionalWorkAmount>
    <config>
      <Profile>
        <Category>BDP_ChipCategory_Defense</Category>
        <Tags>
          <li>BDP_ChipTag_EnergyForm</li>
        </Tags>
      </Profile>
      <Loadout>
        <SlotRegion>MainSub</SlotRegion>
        <SlotOccupancy>Single</SlotOccupancy>
        <ActivationDelayTicks>60</ActivationDelayTicks>
        <DeactivationDelayTicks>30</DeactivationDelayTicks>
      </Loadout>
      <Trion><CapacityCost>50</CapacityCost><ActivationCost>15</ActivationCost></Trion>
      <ActivationRequirements>
        <li Class="BDP.Core.Requirements.TrionIntensityRequirement"><Minimum>1</Minimum></li>
      </ActivationRequirements>
      <Expression>
        <Entries>
          <li>
            <Id>energy_shield_primary</Id>
            <DisplayLabel>能量护盾</DisplayLabel>
            <Kind>Hediff</Kind>
            <HediffDefName>BDP_Hediff_EnergyShield</HediffDefName>
            <HediffApplyModeKey>countToSeverity</HediffApplyModeKey>
          </li>
        </Entries>
      </Expression>
    </config>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>

  <!-- 常驻型自动能量护盾：特殊槽专用，全方位防护，不聚合。 -->
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>
    <defName>BDP_Preset_EnergyShield_Auto</defName>
    <label>常驻型自动能量护盾</label>
    <description>常驻型自动能量护盾，特殊槽专用。激活期间始终提供全方位防护，不随激活数量升级。格挡率 70%，成功抵挡消耗 75% 伤害值的 Trion。</description>
    <costList>
      <Silver>120</Silver>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <additionalWorkAmount>700</additionalWorkAmount>
    <config>
      <Profile>
        <Category>BDP_ChipCategory_Defense</Category>
        <Tags>
          <li>BDP_ChipTag_EnergyForm</li>
        </Tags>
      </Profile>
      <Loadout>
        <SlotRegion>Special</SlotRegion>
        <SlotOccupancy>Single</SlotOccupancy>
        <!-- 特殊槽芯片秒开秒关。 -->
        <ActivationDelayTicks>0</ActivationDelayTicks>
        <DeactivationDelayTicks>0</DeactivationDelayTicks>
      </Loadout>
      <Trion><CapacityCost>300</CapacityCost><ActivationCost>0</ActivationCost></Trion>
      <ActivationRequirements>
        <li Class="BDP.Core.Requirements.TrionIntensityRequirement"><Minimum>1</Minimum></li>
      </ActivationRequirements>
      <Expression>
        <Entries>
          <li>
            <Id>energy_shield_auto</Id>
            <DisplayLabel>常驻型自动能量护盾</DisplayLabel>
            <Kind>Hediff</Kind>
            <HediffDefName>BDP_Hediff_EnergyShield_Auto</HediffDefName>
            <!-- 不设 HediffApplyModeKey：纯存在模式，不按数量叠加 Severity。 -->
          </li>
        </Entries>
      </Expression>
    </config>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>

  <!-- 紧急脱离：被动崩解时自动传送回安全位置。 -->
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>
    <defName>BDP_Preset_EmergencyEscape</defName>
    <label>紧急脱离</label>
    <description>被动芯片，特殊槽专用。战斗体因 Trion 见底而崩解时自动触发——将装备者传送至安全位置（优先信标锚点），芯片在触发后销毁。</description>
    <costList>
      <Silver>150</Silver>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <additionalWorkAmount>800</additionalWorkAmount>
    <config>
      <Profile>
        <Category>BDP_ChipCategory_Passive</Category>
        <Tags>
          <li>BDP_ChipTag_EnergyForm</li>
        </Tags>
      </Profile>
      <Loadout>
        <SlotRegion>Special</SlotRegion>
        <SlotOccupancy>Single</SlotOccupancy>
        <!-- 特殊槽芯片秒开秒关。 -->
        <ActivationDelayTicks>0</ActivationDelayTicks>
        <DeactivationDelayTicks>0</DeactivationDelayTicks>
      </Loadout>
      <Trion><CapacityCost>400</CapacityCost><ActivationCost>0</ActivationCost></Trion>
      <ActivationRequirements>
        <li Class="BDP.Core.Requirements.TrionIntensityRequirement"><Minimum>1</Minimum></li>
      </ActivationRequirements>
      <Expression>
        <Entries>
          <li>
            <Id>emergency_escape_passive</Id>
            <DisplayLabel>紧急脱离</DisplayLabel>
            <Kind>Passive</Kind>
            <PassiveKey>EmergencyEscape</PassiveKey>
          </li>
        </Entries>
      </Expression>
    </config>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipActionPresetDef>

  <!-- ===== 狙击预设 ===== -->

  <!-- 朱鹮：超远距精确狙击。 -->
