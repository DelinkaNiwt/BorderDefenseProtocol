<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    BDP 枪壳预设。
    每个 ChipGunShellDef 定义一类枪壳的物理特征覆盖集，
    在芯片制造时作为可选的后置修正层叠加到远程表达条目上。
    未声明的字段保留表达模板原值。
  -->

  <!-- 左轮手枪：近程高精度，反应快，单发，高伤害。 -->
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipGunShellDef>
    <defName>BDP_GunClass_Revolver</defName>
    <label>左轮手枪</label>
    <description>近程敏捷型枪械。贴身精度极高，远距衰减明显，单发高伤害。</description>
    <compatibleProfessions>
      <li>BDP_ChipProfession_Gunner</li>
    </compatibleProfessions>
    <additionalCost>
      <Steel>20</Steel>
    </additionalCost>
    <additionalWorkAmount>800</additionalWorkAmount>
    <overrides>
      <!-- 射程与精度：近程贴脸高精度，中远距大幅衰减。 -->
      <range>15</range>
      <!-- 显式覆盖射击模式为逐射。 -->
      <rhythm>Sequential</rhythm>
      <accuracyTouch>0.80</accuracyTouch>
      <accuracyShort>0.75</accuracyShort>
      <accuracyMedium>0.30</accuracyMedium>
      <accuracyLong>0.18</accuracyLong>
      <!-- 射击节奏：单发，与原版左轮手枪一致。 -->
      <warmupTime>0.3</warmupTime>
      <defaultCooldownTime>1.6</defaultCooldownTime>
      <burstShotCount>1</burstShotCount>
      <ticksBetweenBurstShots>15</ticksBetweenBurstShots>
      <!-- 音效：手枪声小，传播半径近。 -->
      <soundCast>Shot_Revolver</soundCast>
      <noiseRadius>8</noiseRadius>
      <muzzleFlashScale>0.6</muzzleFlashScale>
      <!-- 视觉：替换为原版 Revolver 贴图。 -->
      <visualPresetDefName>BDP_Visual_Pistol</visualPresetDefName>
    </overrides>
    <!-- 投射物属性覆盖：单发高伤害、高停止力。 -->
    <projectileOverrides>
      <damageMultiplier>5</damageMultiplier>
      <stoppingPowerMultiplier>2.5</stoppingPowerMultiplier>
    </projectileOverrides>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipGunShellDef>

  <!-- 突击步枪：中远程均衡型，四连发，泛用性最强。 -->
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipGunShellDef>
    <defName>BDP_GunClass_AssaultRifle</defName>
    <label>突击步枪</label>
    <description>中远程均衡型枪械。全距离精度平滑，四连发射击，性能全面。</description>
    <compatibleProfessions>
      <li>BDP_ChipProfession_Gunner</li>
    </compatibleProfessions>
    <additionalCost>
      <Steel>40</Steel>
    </additionalCost>
    <additionalWorkAmount>1200</additionalWorkAmount>
    <overrides>
      <!-- 射程与精度：与原版突击步枪一致。 -->
      <range>30.9</range>
      <!-- 显式覆盖射击模式为逐射。 -->
      <rhythm>Sequential</rhythm>
      <accuracyTouch>0.60</accuracyTouch>
      <accuracyShort>0.70</accuracyShort>
      <accuracyMedium>0.65</accuracyMedium>
      <accuracyLong>0.55</accuracyLong>
      <!-- 射击节奏：四连发，与原版预热/冷却一致。 -->
      <warmupTime>1.0</warmupTime>
      <defaultCooldownTime>1.7</defaultCooldownTime>
      <burstShotCount>4</burstShotCount>
      <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
      <!-- 音效：步枪声，传播半径中等。 -->
      <soundCast>Shot_AssaultRifle</soundCast>
      <noiseRadius>18</noiseRadius>
      <muzzleFlashScale>0.9</muzzleFlashScale>
      <!-- 视觉：替换为原版 AssaultRifle 贴图。 -->
      <visualPresetDefName>BDP_Visual_AssaultRifle</visualPresetDefName>
    </overrides>
    <!-- 投射物属性覆盖：标准停止力。 -->
    <projectileOverrides>
      <stoppingPowerMultiplier>1</stoppingPowerMultiplier>
    </projectileOverrides>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipGunShellDef>

  <!-- 霰弹枪：极近程爆发型，与原版链式霰弹枪参数一致，弹数为芯片预设的2倍。 -->
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipGunShellDef>
    <defName>BDP_GunClass_Shotgun</defName>
    <label>霰弹枪</label>
    <description>极近程爆发型枪械。与原版链式霰弹枪参数一致，弹丸数量翻倍。</description>
    <compatibleProfessions>
      <li>BDP_ChipProfession_Gunner</li>
    </compatibleProfessions>
    <additionalCost>
      <Steel>50</Steel>
    </additionalCost>
    <additionalWorkAmount>1500</additionalWorkAmount>
    <overrides>
      <!-- 射程与精度：近程贴身可靠，中远距大幅衰减。 -->
      <range>12.9</range>
      <!-- 显式覆盖射击模式为齐射。 -->
      <rhythm>Simultaneous</rhythm>
      <accuracyTouch>0.57</accuracyTouch>
      <accuracyShort>0.64</accuracyShort>
      <accuracyMedium>0.55</accuracyMedium>
      <accuracyLong>0.45</accuracyLong>
      <!-- 射击节奏：与原版链式霰弹枪一致，弹数 2 倍率。 -->
      <warmupTime>1.2</warmupTime>
      <defaultCooldownTime>1.35</defaultCooldownTime>
      <burstShotCountMultiplier>2</burstShotCountMultiplier>
      <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
      <!-- 音效：霰弹枪声大，传播半径远。 -->
      <soundCast>Shot_Shotgun</soundCast>
      <noiseRadius>24</noiseRadius>
      <muzzleFlashScale>1.2</muzzleFlashScale>
      <!-- 视觉：替换为原版 Shotgun（泵动霰弹枪）贴图。 -->
      <visualPresetDefName>BDP_Visual_Shotgun</visualPresetDefName>
    </overrides>
    <!-- 投射物属性覆盖：高停止力。 -->
    <projectileOverrides>
      <stoppingPowerMultiplier>3</stoppingPowerMultiplier>
    </projectileOverrides>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipGunShellDef>

</Defs>
