<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 四种芯片主分类只表达唯一归属与制造筛选。 -->
  <BDP.Core.Chips.ChipCategoryDef>
    <defName>BDP_ChipCategory_Weapon</defName>
    <label>武装</label>
    <description>形成直接战斗武装表现的芯片。</description>
  </BDP.Core.Chips.ChipCategoryDef>
  <BDP.Core.Chips.ChipCategoryDef>
    <defName>BDP_ChipCategory_Defense</defName>
    <label>防护</label>
    <description>提供防护和承伤能力的芯片。</description>
  </BDP.Core.Chips.ChipCategoryDef>
  <BDP.Core.Chips.ChipCategoryDef>
    <defName>BDP_ChipCategory_GeneralSkill</defName>
    <label>通用技能</label>
    <description>提供可主动调用的通用技能和状态效果。</description>
  </BDP.Core.Chips.ChipCategoryDef>
  <BDP.Core.Chips.ChipCategoryDef>
    <defName>BDP_ChipCategory_Accessory</defName>
    <label>配件</label>
    <description>作为独立配件提供附加战斗效果的芯片。</description>
  </BDP.Core.Chips.ChipCategoryDef>

  <!-- 隐秘组：同组芯片不能同时启用，只能在主副槽之间切换。 -->
  <BDP.Core.Chips.ChipExclusionGroupDef>
    <defName>BDP_ChipExclusionGroup_Stealth</defName>
    <label>隐秘组</label>
    <description>同属隐秘组的芯片只能同时启用一枚。</description>
  </BDP.Core.Chips.ChipExclusionGroupDef>

  <!-- 独立且互斥的职业体系；可被任意主分类的芯片功能引用。 -->
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipProfessionDef>
    <defName>BDP_ChipProfession_Attacker</defName>
    <label>攻击手</label>
    <description>使用攻击手原生动作。</description>
    <acceptedSourceProfessions>
      <li>BDP_ChipProfession_Attacker</li>
    </acceptedSourceProfessions>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipProfessionDef>
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipProfessionDef>
    <defName>BDP_ChipProfession_Shooter</defName>
    <label>射手</label>
    <description>使用射手原生动作。</description>
    <acceptedSourceProfessions>
      <li>BDP_ChipProfession_Shooter</li>
    </acceptedSourceProfessions>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipProfessionDef>
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipProfessionDef>
    <defName>BDP_ChipProfession_Gunner</defName>
    <label>枪手</label>
    <description>可使用枪手和射手原生动作。</description>
    <acceptedSourceProfessions>
      <li>BDP_ChipProfession_Gunner</li>
      <li>BDP_ChipProfession_Shooter</li>
    </acceptedSourceProfessions>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipProfessionDef>
  <BDP.Content.Assembly.ChipManufacturing.Defs.ChipProfessionDef>
    <defName>BDP_ChipProfession_Sniper</defName>
    <label>狙击手</label>
    <description>使用狙击手原生动作。</description>
    <acceptedSourceProfessions>
      <li>BDP_ChipProfession_Sniper</li>
    </acceptedSourceProfessions>
  </BDP.Content.Assembly.ChipManufacturing.Defs.ChipProfessionDef>

  <!-- 可多选的普通特征标签，不承担职业语义。 -->
  <BDP.Core.Chips.ChipTagDef>
    <defName>BDP_ChipTag_Entity</defName>
    <label>实体</label>
    <description>主要形成实体武装或实体表现。</description>
  </BDP.Core.Chips.ChipTagDef>
  <BDP.Core.Chips.ChipTagDef>
    <defName>BDP_ChipTag_Offensive</defName>
    <label>进攻型</label>
    <description>主要用于进攻方向。</description>
  </BDP.Core.Chips.ChipTagDef>
  <BDP.Core.Chips.ChipTagDef>
    <defName>BDP_ChipTag_KogetsuExclusive</defName>
    <label>弧月专属</label>
    <description>只对弧月体系开放或有特殊关联。</description>
  </BDP.Core.Chips.ChipTagDef>
  <BDP.Core.Chips.ChipTagDef>
    <defName>BDP_ChipTag_EnergyForm</defName>
    <label>能量体</label>
    <description>主要以能量体形式形成表现。</description>
  </BDP.Core.Chips.ChipTagDef>
</Defs>
