<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 近界宙域唯一基础袭击角色；档位与装备配置留待后续完整设计。 -->
  <PawnKindDef>
    <!-- 近界宙域袭击角色唯一标识。 -->
    <defName>BDP_NearRealm_Combatant</defName>
    <!-- 角色名称由简体中文 DefInjected 提供。 -->
    <label>BDP_NearRealm_Combatant.label</label>
    <!-- 所有近界成员仍是原版人类 Pawn。 -->
    <race>Human</race>
    <!-- 角色所属的正式近界宙域派系。 -->
    <defaultFactionDef>BDP_Faction_NearRealm</defaultFactionDef>
    <!-- 当前近界民战斗员袭击强度暂定为 80 点，档位设计仍待后续完善。 -->
    <combatPower>80</combatPower>
    <!-- 该角色属于战斗人员。 -->
    <isFighter>true</isFighter>
    <!-- 沿用原版装备掉落销毁规则，避免角色掉落已装备的触发体。 -->
    <destroyGearOnDrop>true</destroyGearOnDrop>
    <!-- 原型触发体基础价 120、预装三枚各 100 点芯片，武器预算与动态价值 420 对齐。 -->
    <weaponMoney>420~420</weaponMoney>
    <!-- 参照原版海盗枪手配置服装预算，为战斗体镜像提供原身衣物。 -->
    <apparelMoney>400~1000</apparelMoney>
    <!-- 沿用原版海盗枪手的服装候选标签，按服装自身标签筛选。 -->
    <apparelTags>
      <!-- 原版基础工业服装。 -->
      <li>IndustrialBasic</li>
      <!-- 原版高级工业服装。 -->
      <li>IndustrialAdvanced</li>
      <!-- 原版基础军用工业服装。 -->
      <li>IndustrialMilitaryBasic</li>
      <!-- 原版高级军用工业服装。 -->
      <li>IndustrialMilitaryAdvanced</li>
    </apparelTags>
    <weaponTags>
      <li>BDP_NearRealmPrototype</li>
    </weaponTags>
    <!-- 初始意志与抵抗沿用原版 35 战力流浪者 Drifter 的范围。 -->
    <initialWillRange>0~1</initialWillRange>
    <initialResistanceRange>7~12</initialResistanceRange>
  </PawnKindDef>

  <!-- 皇室任务追兵使用的近界民斥候；除不销毁掉落装备外，其余设定与战斗员一致。 -->
  <PawnKindDef>
    <!-- 近界民斥候角色唯一标识。 -->
    <defName>BDP_NearRealm_Scout</defName>
    <!-- 角色名称由简体中文 DefInjected 提供。 -->
    <label>BDP_NearRealm_Scout.label</label>
    <!-- 斥候仍是原版人类 Pawn。 -->
    <race>Human</race>
    <!-- 默认归属近界宙域；任务生成时仍显式指定任务所属派系。 -->
    <defaultFactionDef>BDP_Faction_NearRealm</defaultFactionDef>
    <!-- 与近界民战斗员相同的袭击战力。 -->
    <combatPower>80</combatPower>
    <!-- 该角色属于战斗人员。 -->
    <isFighter>true</isFighter>
    <!-- 沿用原型触发体装备预算与标签；不设置 destroyGearOnDrop，让装备按原版规则掉落。 -->
    <weaponMoney>420~420</weaponMoney>
    <weaponTags>
      <li>BDP_NearRealmPrototype</li>
    </weaponTags>
    <!-- 初始意志与抵抗沿用近界民战斗员。 -->
    <initialWillRange>0~1</initialWillRange>
    <initialResistanceRange>7~12</initialResistanceRange>
  </PawnKindDef>

</Defs>
