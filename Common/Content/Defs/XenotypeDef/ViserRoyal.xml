<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 皇室加入任务固定使用此异种，使角色身份与其遗传基因组合一致。 -->
  <XenotypeDef>
    <!-- 薇瑟皇裔异种唯一标识。 -->
    <defName>BDP_Xenotype_ViserRoyal</defName>
    <!-- 异种名称从简体中文语言包注入。 -->
    <label>BDP_Xenotype_ViserRoyal.label</label>
    <!-- 异种说明从简体中文语言包注入。 -->
    <description>BDP_Xenotype_ViserRoyal.description</description>
    <!-- 复用原版基底人图标，不新增美术资源。 -->
    <iconPath>UI/Icons/Xenotypes/Baseliner</iconPath>
    <!-- 该基因组合可由后代遗传。 -->
    <inheritable>true</inheritable>
    <!-- 不参与无派系人物的随机异种生成，只由皇室任务明确指定。 -->
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <!-- 皇室人物固定携带以下可遗传基因。 -->
    <genes>
      <!-- 强免疫基因。 -->
      <li>Immunity_Strong</li>
      <!-- 心灵过敏基因。 -->
      <li>PsychicAbility_Extreme</li>
      <!-- 心灵伴侣基因。 -->
      <li>PsychicBonding</li>
      <!-- 慢性子基因。 -->
      <li>MoveSpeed_Slow</li>
      <!-- 无暴力基因。 -->
      <li>ViolenceDisabled</li>
      <!-- 脆弱基因。 -->
      <li>Delicate</li>
      <!-- 魅力出众基因。 -->
      <li>Beauty_Pretty</li>
      <!-- 无胡须基因。 -->
      <li>Beard_NoBeardOnly</li>
      <!-- 纤细体型基因。 -->
      <li>Body_Thin</li>
      <!-- 皇室血脉身份基因。 -->
      <li>BDP_Gene_RoyalBloodline</li>
      <!-- 采矿无能基因。 -->
      <li>AptitudeTerrible_Mining</li>
      <!-- 种植才疏基因。 -->
      <li>AptitudePoor_Plants</li>
      <!-- 艺术出色基因。 -->
      <li>AptitudeStrong_Artistic</li>
      <!-- 社交超群基因。 -->
      <li>AptitudeRemarkable_Social</li>
    </genes>
  </XenotypeDef>
</Defs>
