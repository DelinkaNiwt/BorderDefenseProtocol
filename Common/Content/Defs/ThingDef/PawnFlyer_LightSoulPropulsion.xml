<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 光魂推进专用贴地冲刺飞行器，不复用蚱蜢的业务视觉。 -->
  <ThingDef ParentName="PawnFlyerBase">
    <!-- ThingDef（物品定义）唯一名称。 -->
    <defName>BDP_PawnFlyer_LightSoulPropulsion</defName>
    <label>光魂推进飞行器</label>
    <thingClass>BDP.Content.LightSoul.Propulsion.PawnFlyer_LightSoulPropulsion</thingClass>

    <!-- 贴图与迷雾可见性设置。 -->
    <seeThroughFog>true</seeThroughFog>
    <drawerType>RealtimeOnly</drawerType>

    <!-- 使用快速、单调、贴地的冲刺曲线。 -->
    <pawnFlyer>
      <flightSpeed>45</flightSpeed>
      <flightDurationMin>0.1</flightDurationMin>
      <heightFactor>0</heightFactor>
      <progressCurve Inherit="False">
        <points>
          <li>(0, 0)</li>
          <li>(0.1, 0.5)</li>
          <li>(0.25, 0.96)</li>
          <li>(0.85, 0.995)</li>
          <li>(1, 1)</li>
        </points>
      </progressCurve>
    </pawnFlyer>
  </ThingDef>

</Defs>
