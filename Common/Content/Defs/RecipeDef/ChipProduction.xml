<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 唯一通用芯片配方；具体材料与工作量由账单组合动态计算。 -->
  <RecipeDef>
    <defName>BDP_Recipe_ProduceChip</defName>
    <!-- 建造或制造须满足所有研究；不影响现有装备使用。 -->
    <researchPrerequisites><li>BDP_Research_BasicTriggerEngineering</li></researchPrerequisites>
    <label>制造芯片</label>
    <jobString>正在制造芯片。</jobString>
    <workerClass>BDP.Content.Assembly.ChipManufacturing.Recipe.RecipeWorker_ChipProduction</workerClass>
    <!-- 统一芯片基底：钢铁15、工业零部件2；功能和构型成本由动态账单另行累加。 -->
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>15</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>2</count></li>
    </ingredients>
    <products>
      <BDP_Chip_Custom>1</BDP_Chip_Custom>
    </products>
    <workAmount>6000</workAmount>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>1</workSkillLearnFactor>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <unfinishedThingDef>BDP_Chip_Unfinished</unfinishedThingDef>
    <allowMixingIngredients>false</allowMixingIngredients>
    <defaultIngredientFilter><thingDefs><li>Steel</li><li>ComponentIndustrial</li></thingDefs></defaultIngredientFilter>
  </RecipeDef>

</Defs>
